FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONPATH=/app/src \
    STREAMLIT_SERVER_HEADLESS=true \
    STREAMLIT_BROWSER_GATHER_USAGE_STATS=false

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender1 \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

COPY service/requirements-docker.txt /app/service/requirements-docker.txt
RUN pip install -r /app/service/requirements-docker.txt

COPY README.md /app/README.md
COPY service /app/service
COPY src /app/src
COPY data/interim/dataset_summary.json /app/data/interim/dataset_summary.json
COPY reports/line_role_baseline /app/reports/line_role_baseline
COPY reports/line_role_expanded_sgd_v1 /app/reports/line_role_expanded_sgd_v1
COPY reports/parser_cascade_v1_expanded /app/reports/parser_cascade_v1_expanded
COPY reports/ocr_backend_benchmark_cascade_v1 /app/reports/ocr_backend_benchmark_cascade_v1

EXPOSE 8501

HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8501/_stcore/health', timeout=5)"

CMD ["streamlit", "run", "service/streamlit_app.py", "--server.address=0.0.0.0", "--server.port=8501"]
